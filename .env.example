# Copia questo file in .env (sul Mac) oppure imposta le stesse variabili su Vercel
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys > "secret" (o la vecchia "service_role")
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Facoltativo ma consigliato su Vercel: PIN chiesto una volta sull'iPad
APP_PIN=
PORT=3000
